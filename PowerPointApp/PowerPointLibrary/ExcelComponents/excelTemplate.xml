				<cell>Ortalama</cell>
				<cell>80</cell>
				<cell>100</cell>
				<cell formula="=AVERAGE(B6:C6)"></cell>
			</row>

			<row>
				<cell>En Küçük</cell>
				<cell>15</cell>
				<cell>5</cell>
				<cell formula="=MIN(B7:C7)"></cell>
			</row>

			<row>
				<cell>En Büyük</cell>
				<cell>33</cell>
				<cell>77</cell>
				<cell formula="=MAX(B8:C8)"></cell>
			</row>

			<row>
				<cell>Geçti mi?</cell>
				<cell>60</cell>
				<cell></cell>
				<cell formula="=IF(B9&gt;=50, &quot;Geçti&quot;, &quot;Kaldı&quot;)"></cell>
			</row>
			<row>
				<cell>Yuvarlama</cell>
				<cell>3,14159</cell>
				<cell></cell>
				<cell formula="=ROUND(B10; 2)"></cell>
			</row>

			<row>
				<cell>Mod (kalan)</cell>
				<cell>17</cell>
				<cell>4</cell>
				<cell formula="=MOD(B11; C11)"></cell>
			</row>

			<row>
				<cell>Metin uzunluğu</cell>
				<cell>Merhaba</cell>
				<cell></cell>
				<cell formula="=LEN(B12)"></cell>
			</row>

			<row>  
				<cell>Ad + Soyad</cell>
