@{
    ViewBag.Title = "Tüm Tablolar";
    var tables = ViewBag.AllTables as Dictionary<string, System.Data.DataTable>;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

<div class="container mt-5">
    <h1 class="mb-4">📋 Tablolar (XML'den)</h1>

    @if (tables == null || tables.Count == 0)
    {
        <div class="alert alert-warning">Görüntülenecek tablo bulunamadı.</div>
    }
    else
    {
        foreach (var table in tables)
        {
            <hr />
            <h4 class="mt-4">🗂️ @table.Key</h4>
            <div class="table-responsive">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            @foreach (System.Data.DataColumn col in table.Value.Columns)
                            {
                                <th>@col.ColumnName</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (System.Data.DataRow row in table.Value.Rows)
                        {
                            <tr>
                                @foreach (var item in row.ItemArray)
                                {
                                    <td>@item</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>


            </div>

        }



    }

    @if (ViewBag.ChartOnlyPdf != null)
    {
        <hr />
        <h4>📈 Grafik PDF:</h4>
        <iframe src="@ViewBag.ChartOnlyPdf" width="100%" height="500px" style="border:1px solid #ccc;"></iframe>
    }
</div>
